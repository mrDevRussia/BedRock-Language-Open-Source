root DATA_ADDR = 0x1000; // عنوان تخيلي للبيانات
root VGA = 0xB8000;

fn main() {
    let key = 0xAA;
    let i = 0;
    
    // مصفوفة بيانات وهمية لتشفيرها
    let buffer = [72, 101, 108, 108, 111]; // كلمة "Hello"
    
    while (i < 5) {
        let original = buffer[i];
        
        // عملية XOR بسيطة للتشفير
        let encrypted = original ^ key; 
        
        // لو القيمة المشفرة أكبر من 100، ارسم نقطة بيضاء
        if (encrypted > 100) {
            poke(VGA + (i * 2), encrypted);
        } else {
            poke(VGA + (i * 2), 0x2E); // نقطة "."
        }
        
        i = i + 1;
    }
}